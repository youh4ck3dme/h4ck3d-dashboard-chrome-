{
  "compilerOptions": {
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": ["node"],
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "noEmit": true
  },
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "e2e/**/*.ts",
    "playwright.release.config.ts",
    "release/**/*.ts"
  ]
}
